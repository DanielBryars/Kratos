# Copy to .env, which Git ignores, and set a password. Nothing here is a usable default secret.
KRATOS_GRAFANA_ADMIN_USER=kratos-admin
KRATOS_GRAFANA_ADMIN_PASSWORD=
# Loopback ports. Change one if it is already taken on this machine.
KRATOS_GRAFANA_PORT=13000
KRATOS_MLFLOW_PORT=15000
KRATOS_OTLP_GRPC_PORT=14317
KRATOS_OTLP_HTTP_PORT=14318
