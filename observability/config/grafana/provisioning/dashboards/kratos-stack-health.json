{
  "uid": "kratos-stack-health",
  "title": "Kratos observability health",
  "tags": ["kratos"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Whether the observability stack itself is working. This is the dashboard to open when another dashboard is empty, because it distinguishes 'nothing is being sent' from 'something is broken'.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Each backend Prometheus scrapes. A zero here explains an empty panel elsewhere.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kratos-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active series",
      "description": "ADR-015 keeps job and attempt identifiers off metric series precisely so this number does not grow with every run. A steady climb while nothing new is deployed means that rule has been broken somewhere.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kratos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "series"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Samples ingested per second",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kratos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
          "legendFormat": "samples/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Series growth",
      "description": "The shape that matters more than the number: flat is healthy, a staircase means new label values are arriving from somewhere.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "kratos-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "min": 0 },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "prometheus_tsdb_head_series", "legendFormat": "active series" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Storage in use",
      "description": "Each backend bounds its own retention. This is the number the storage budget in observability/budget.sh is about.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "kratos-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_storage_blocks_bytes",
          "legendFormat": "prometheus blocks"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent stack logs",
      "description": "The observability services talking about themselves. A gateway refusing pushes shows up here first.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "kratos-loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"}" }]
    }
  ]
}
